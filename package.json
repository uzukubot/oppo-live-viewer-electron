{
  "name": "oppo-live-viewer-electron",
  "version": "0.1.0",
  "description": "OPPO Live Photo / Ultra HDR 查看器（Electron 版，自带 Chromium 输出真 HDR）",
  "author": "uzukubot",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite dev\" \"wait-on tcp:1420 && electron . --dev\"",
    "dev:app": "electron . --dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "selftest": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "image-size": "^2.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.uzukubot.oppo-live-viewer-electron",
    "productName": "OPPO-Live-Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**",
      "electron/**"
    ],
    "win": {
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "OPPO-Live-Viewer-${version}-portable.exe"
    },
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Graphics"
    }
  }
}
